rules_version = '2';

// AI 教育平台儀表板 — 班級 / 學生資料
// 安全模式：匿名登入 + 規則保護。僅已登入（含匿名）使用者可讀寫，
// 且限定欄位型別，避免任意結構寫入。
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    match /classes/{classId} {
      allow read: if signedIn();
      allow write: if signedIn()
        && request.resource.data.name is string
        && request.resource.data.grade is string;
    }

    match /students/{studentId} {
      allow read: if signedIn();
      allow write: if signedIn()
        && request.resource.data.classId is string
        && request.resource.data.name is string
        && request.resource.data.seatNo is number;
    }

    // AI 試題工廠：題庫
    match /examQuestions/{qId} {
      allow read: if signedIn();
      allow write: if signedIn()
        && request.resource.data.subject is string
        && request.resource.data.stem is string;
    }

    // AI 作文批改：批改記錄
    match /essayReviews/{rId} {
      allow read: if signedIn();
      allow write: if signedIn()
        && request.resource.data.title is string
        && request.resource.data.gradeLevel is string;
    }

    // 其餘路徑一律拒絕
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
